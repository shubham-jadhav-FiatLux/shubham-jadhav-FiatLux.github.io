{
  "name": "valley-of-whispering-bamboo",
  "version": "0.5.0",
  "private": true,
  "description": "An explorable 3D portfolio: guide a panda through a misty valley of bamboo, blossoms and pagodas to discover projects, skills and stories.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "shots": "node scripts/screenshots.mjs",
    "e2e": "node scripts/smoke.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "keywords": [
    "portfolio",
    "threejs",
    "webgl",
    "glsl",
    "game",
    "procedural",
    "panda"
  ],
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "lil-gui": "^0.21.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
